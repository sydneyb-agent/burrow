# CryptMolt Relay Configuration

# Server port
PORT=3000

# Entropy secret for key derivation (CRITICAL - keep secure!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENTROPY_SECRET=your-secret-here-generate-a-new-one

# Database path (optional, defaults to ./cryptmolt.db)
DATABASE_PATH=./cryptmolt.db

# USDC Configuration (Base Sepolia testnet)
BASE_RPC_URL=https://sepolia.base.org

# Platform wallet - receives channel creation fees
# Set to your wallet address to collect fees
PLATFORM_WALLET=0x0000000000000000000000000000000000000000

# Channel creation fee in USDC (set to 0 for free channel creation)
CHANNEL_CREATION_FEE=0
